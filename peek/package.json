{
  "name": "elastic-peek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "co.elastic.peek",
    "productName": "Elastic Peek",
    "directories": {
      "output": "dist-packages"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "screenshot:preflight": "node scripts/screenshot-preflight.mjs",
    "generate:types": "node scripts/filter-es-openapi.mjs && npx openapi-typescript src/services/es/elasticsearch-esql.openapi.json -o src/services/es/types.generated.d.ts",
    "prepare": "cd .. && husky",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "cross-env ELECTRON=true tsc && cross-env ELECTRON=true vite build",
    "electron:dist": "npm run electron:build && electron-builder"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.37",
    "@codemirror/lang-sql": "^6.8.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/instrumentation-document-load": "^0.55.0",
    "@opentelemetry/instrumentation-fetch": "^0.55.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.55.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@perses-dev/components": "^0.52.0",
    "@perses-dev/core": "^0.53.0",
    "@uiw/react-codemirror": "^4.23.0",
    "ai": "^6.0.97",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "overrides": {
    "glob": "^13.0.0"
  },
  "overridesMeta": {
    "glob": "Pinned to force consistent transitive dependency resolution. Glob v13 has breaking changes (including CLI split to glob-bin) and Node runtime requirements (20 or >=22); revisit this override when upgrading related tooling."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@elastic/elasticsearch": "^9.3.2",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@size-limit/file": "^12.0.0",
    "@testcontainers/elasticsearch": "^11.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.6.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "size-limit": "^11.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.0",
    "use-resize-observer": "^9.1.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "optionalDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  }
}
