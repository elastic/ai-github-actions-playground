server {
    listen 80;

    # Proxy ES|QL queries to Elasticsearch to avoid CORS.
    # ES_URL is substituted at container startup from the ES_URL environment variable.
    location /_query {
        proxy_pass ${ES_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_request_headers on;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
